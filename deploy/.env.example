# CustosMachina 平台配置示例（复制为 .env 后修改）

# --- 必填 ---
# JWT 密钥（随机长字符串，如 openssl rand -hex 32）
CUSTOS_AUTH_JWT_SECRET=

# 组件凭证加密主密钥（32 字节 hex，如 openssl rand -hex 32；不设则无法保存 IM 凭证）
CUSTOS_SECRETS_MASTER_KEY=

# --- 对外访问 ---
# 平台对外可达地址（IM 扫码回调要求公网 HTTPS；本地体验可留空或 http://localhost）
CUSTOS_IM_PUBLIC_URL=

# 扫码成功后重定向回的前端地址（默认 http://localhost，按实际域名改）
CUSTOS_IM_FRONTEND_URL=http://localhost

# 前端对外端口（默认 80）
FRONTEND_PORT=80

# --- IM 扫码登录 ---
# 提供商：wecom / dingtalk / feishu（凭证在首次启动向导中配置，AES 加密落库）
# 本地无公网回调时联调可用 mock，生产严禁
CUSTOS_IM_PROVIDER=wecom

# --- Redis（refresh token 存储 / 登出踢下线；留空则内存模式，重启需重新登录） ---
# CUSTOS_REDIS_ADDR=redis:6379
# CUSTOS_REDIS_PASSWORD=
# CUSTOS_REDIS_DB=0

# --- 日志（zap 文件滚动，映射容器内 /data/logs；设为宿主机路径即 bind mount 到宿主机） ---
# CUSTOS_LOG_DIR=./data/logs

# --- 平台自库（默认 SQLite 零依赖） ---
# CUSTOS_DATABASE_DRIVER=sqlite
# CUSTOS_DATABASE_DSN=/data/custos.db
# MySQL 示例：CUSTOS_DATABASE_DRIVER=mysql CUSTOS_DATABASE_DSN=custos:pass@tcp(mysql:3306)/custos?charset=utf8mb4&parseTime=True
# PostgreSQL 示例：CUSTOS_DATABASE_DRIVER=postgres CUSTOS_DATABASE_DSN=host=postgres user=custos password=pass dbname=custos

# 仅本地开发直跑（go run / make dev）豁免 JWT 默认值检查用；docker 部署勿设
# CUSTOS_AUTH_ALLOW_DEFAULT_SECRET=1

# --- 安全开关（v0.12.1 审计批次） ---
# IM 扫码首次登录自动注册（JIT）：设 0 关闭（未绑定用户被拒，需管理员建号）
CUSTOS_IM_JIT_REGISTER=1
# AI 中转层 endpoint 指向内网/回环（自建 LLM）时豁免 SSRF 校验
#CUSTOS_AI_ALLOW_PRIVATE_ENDPOINT=1
