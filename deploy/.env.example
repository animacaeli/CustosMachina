# CustosMachina 平台配置示例（复制为 .env 后修改）

# --- 必填 ---
# JWT 密钥（随机长字符串，如 openssl rand -hex 32）
CUSTOS_AUTH_JWT_SECRET=

# 组件凭证加密主密钥（32 字节 hex，如 openssl rand -hex 32；不设则无法保存 IM 凭证）
CUSTOS_SECRETS_MASTER_KEY=

# --- 对外访问 ---
# 平台对外可达地址（IM 扫码回调要求公网 HTTPS；本地体验可留空或 http://localhost）
CUSTOS_IM_PUBLIC_URL=

# 扫码成功后重定向回的前端地址（默认 http://localhost，按实际域名改）
CUSTOS_IM_FRONTEND_URL=http://localhost

# 前端对外端口（默认 80）
FRONTEND_PORT=80

# --- IM 扫码登录 ---
# 提供商：wecom / dingtalk / feishu（凭证在首次启动向导中配置，AES 加密落库）
# 本地无公网回调时联调可用 mock，生产严禁
CUSTOS_IM_PROVIDER=wecom

# --- 平台自库（默认 SQLite 零依赖） ---
# CUSTOS_DATABASE_DRIVER=sqlite
# CUSTOS_DATABASE_DSN=/data/custos.db
# MySQL 示例：CUSTOS_DATABASE_DRIVER=mysql CUSTOS_DATABASE_DSN=user:pass@tcp(host:3306)/custos
# PostgreSQL 示例：CUSTOS_DATABASE_DRIVER=postgres CUSTOS_DATABASE_DSN=host=... user=... password=... dbname=custos
